# Copy to .env.testing so `php artisan test` does not wipe your dev MySQL data.
# Create the empty database first, e.g.:
#   mysql -e "CREATE DATABASE IF NOT EXISTS food_portal_testing;"
#
# Then: cp .env.testing.example .env.testing
#       php artisan migrate --env=testing

APP_ENV=testing
APP_KEY=
APP_DEBUG=true

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=food_portal_testing
DB_USERNAME=root
DB_PASSWORD=

CACHE_DRIVER=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
