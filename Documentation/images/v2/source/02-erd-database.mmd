erDiagram
    USERS ||--o{ FOOD_LISTINGS : "donor_id posts"
    USERS ||--o{ FOOD_LISTINGS : "claimed_by claims"
    USERS ||--o{ FOOD_LISTINGS : "moderated_by reviews"
    USERS ||--o{ VERIFICATION_DOCUMENTS : "user_id uploads"
    USERS ||--o{ VERIFICATION_DOCUMENTS : "reviewed_by"
    USERS ||--o{ NOTIFICATIONS : "user_id receives"
    USERS ||--o{ LISTING_FEEDBACK : "recipient_id rates"
    FOOD_LISTINGS ||--o{ LISTING_FEEDBACK : "food_listing_id"

    USERS {
        bigint id PK
        string name
        string email UK
        string password
        enum role "donor|recipient|admin|volunteer"
        boolean is_active
        string verification_status
        string business_name
        string phone
        string ngo_name
        string contact_person
        string address
        decimal latitude
        decimal longitude
    }

    FOOD_LISTINGS {
        bigint id PK
        bigint donor_id FK
        string title
        enum category "veg|non_veg"
        string quantity
        string photo_path
        string pickup_address
        string city
        decimal latitude
        decimal longitude
        datetime expiry_at
        enum status "AVAILABLE|CLAIMED|DELIVERED|EXPIRED"
        string moderation_status
        string rejection_reason
        bigint moderated_by FK
        datetime moderated_at
        bigint claimed_by FK
        datetime claimed_at
        datetime delivered_at
    }

    VERIFICATION_DOCUMENTS {
        bigint id PK
        bigint user_id FK
        string file_path
        string original_name
        string status
        text admin_note
        bigint reviewed_by FK
        datetime reviewed_at
    }

    NOTIFICATIONS {
        bigint id PK
        bigint user_id FK
        string title
        text body
        datetime read_at
    }

    LISTING_FEEDBACK {
        bigint id PK
        bigint food_listing_id FK
        bigint recipient_id FK
        tinyint rating
        string comment
    }
