sequenceDiagram
    autonumber
    actor User as Donor or Volunteer
    participant Food as FoodListingController
    participant Vol as VolunteerController
    participant Cmd as food:expire
    participant DB as food_listings

    alt Donor delivers
        User->>Food: POST /food/id/deliver
        Food->>DB: UPDATE DELIVERED
    else Volunteer completes
        User->>Vol: POST /volunteer/tasks/id/complete
        Vol->>DB: UPDATE DELIVERED
    end

    Note over Cmd,DB: Hourly scheduler
    Cmd->>DB: SET EXPIRED where AVAILABLE and past expiry
