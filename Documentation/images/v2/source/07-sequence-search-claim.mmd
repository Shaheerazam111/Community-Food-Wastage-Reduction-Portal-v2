sequenceDiagram
    autonumber
    actor NGO as Recipient
    participant Food as FoodListingController
    participant Claim as ClaimController
    participant DB as food_listings
    participant NS as NotificationService

    NGO->>Food: GET /food/search
    Food->>DB: SELECT AVAILABLE APPROVED not expired
    Food-->>NGO: List with distance

    NGO->>Claim: POST /food/id/claim
    Claim->>Claim: verification_status approved?
    Claim->>DB: UPDATE WHERE AVAILABLE APPROVED
    alt row updated
        Claim->>NS: notify donor
        Claim-->>NGO: Success
    else zero rows
        Claim-->>NGO: 409 error
    end
